<?xml version="1.0" encoding="UTF-8"?>
<!--
  CI 专用 Maven settings（仅 GitHub Actions 使用，本地开发仍走 pom.xml 里的阿里云镜像）。

  原因：根 pom 把 repository 指向 http://maven.aliyun.com（国内镜像）。GitHub 托管 runner
  在境外，访问该镜像可能超时或限速，导致拉不到依赖的假失败。这里用 mirrorOf 把**所有**仓库
  请求改走 Maven Central。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <mirrors>
        <mirror>
            <id>central-override</id>
            <name>Maven Central (CI only)</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>

</settings>
