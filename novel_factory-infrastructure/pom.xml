<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.novel.yonren</groupId>
        <artifactId>novel_factory</artifactId>
        <version>1.3.0</version>
    </parent>

    <artifactId>novel_factory-infrastructure</artifactId>

    <dependencies>
        

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>


        <!-- 系统模块 -->
        <dependency>
            <groupId>cn.novel.yonren</groupId>
            <artifactId>novel_factory-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <!-- Anthropic Messages 协议（/v1/messages）：Claude 官方与 anthropic 协议中转站 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-anthropic</artifactId>
            <exclusions>
                <!-- Spring AI 把 io.rest-assured:json-path 声明为 compile 依赖（测试框架误标），
                     会连带拖入 groovy / groovy-json 约 7.5M 到运行时包。生产链路完全不用，
                     排除后包体积实测减少 7.5M（2026-11-05）。若未来需要 rest-assured 做集成测试，
                     请在测试模块显式以 test 作用域引入。 -->
                <exclusion>
                    <groupId>io.rest-assured</groupId>
                    <artifactId>json-path</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 向量库客户端（Qdrant gRPC；client POM 的 grpc 依赖为 runtime 作用域，编译期需显式引入） -->
        <dependency>
            <groupId>io.qdrant</groupId>
            <artifactId>client</artifactId>
            <version>1.14.1</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>1.65.1</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>1.65.1</version>
        </dependency>

        <!-- 离线校准等手动测试所需 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>novel_factory-infrastructure</finalName>
    </build>

</project>
