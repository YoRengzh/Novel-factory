# 构建产物
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
.vscode/

# 运行时数据（故事正文/记忆/检查点——按需本地生成）
data/
docs/workspace/
*.log

# 发布构建产物（zip 与组装目录——由 tools/build-release.sh 与 package-release.sh 生成）
dist/

# Node/Electron 依赖（465MB，由 package-lock.json 锁定、npm install 重建——绝不可入库）
node_modules/

# 密钥与本地配置（含 API key，严禁入库）
application-local.yml
*.local.yml
.env

# 系统
.DS_Store
Thumbs.db

# AI 会话本地产物
.zcode/
