        <mxCell id="n1" value="&lt;div style=&quot;font-weight:bold&quot;&gt;① RootNode · 规则树根节点&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;路由入口（进入规则树）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
