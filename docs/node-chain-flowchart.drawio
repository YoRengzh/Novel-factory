        </mxCell>

        <mxCell id="n6" value="&lt;div style=&quot;font-weight:bold&quot;&gt;⑥ BuildStageBlueprintNode · 阶段蓝图（滚动大纲）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;RollingOutlineService（阶段窗口 / 链式生成，失败重试一次）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;LlmInvokeService · ChapterMemoryService&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;StageExitReviewService（阶段出口裁决）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;ForeshadowSettlementService（伏笔结算）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;ForeshadowScheduleService（DONE → 回写排期 PAID）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;IStoryRepository（蓝图持久化）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
