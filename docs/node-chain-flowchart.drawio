        <mxCell id="n2" value="&lt;div style=&quot;font-weight:bold&quot;&gt;② ValidateUserInputNode · 输入校验&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;必填字段与章数校验（缺失 → NULL_EXCEPTION）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="200" width="420" height="56" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="&lt;div style=&quot;font-weight:bold&quot;&gt;③ BuildStoryContextNode · 故事上下文&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;组装故事圣经：标题/类型/世界观/视角/基调/主人公&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;人物档案与续写全局总章数一并渲染&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="290" width="420" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="&lt;div style=&quot;font-weight:bold&quot;&gt;④ EnsureCharacterDecisionProfilesNode · 人物决策档案&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;CharacterProfilePlanningService.ensure&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;└ CharacterDecisionDesignService（决策档案设计）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;└ IStoryRepository（档案读写）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="394" width="420" height="87" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="&lt;div style=&quot;font-weight:bold&quot;&gt;⑤ BuildVolumeBlueprintNode · 卷蓝图（全书长期锚）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;RollingOutlineService（卷窗口判断 / 卷 Prompt / 链式生成）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;LlmInvokeService（卷蓝图调用）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555&quot;&gt;StoryMemoryService（retrieveDirections 方向检索）&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
