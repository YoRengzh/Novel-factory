<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.novel.yonren</groupId>
    <artifactId>novel_factory</artifactId>
    <version>1.3.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>novel_factory-api</module>
        <module>novel_factory-app</module>
        <module>novel_factory-domain</module>
        <module>novel_factory-trigger</module>
        <module>novel_factory-infrastructure</module>
        <module>novel_factory-types</module>
    </modules>

    <repositories>
        <repository>
            <id>nexus-aliyun</id>
            <name>nexus-aliyun</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 注意：勿将 logback 钉到 1.5.15！logback-spring.xml 使用了 SizeAndTimeBasedFNATP，
             该兼容类 1.5.16 才重新引入，1.5.15 会抛 NoSuchFieldError: dateInCurrentPeriod。
             （框架类采用内联实现，避免 shade jar 及其连带的类冲突） -->
    </properties>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
    </parent>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 钉住 protobuf：qdrant client 1.14 的 gRPC 依赖 3.25.x，
                 防止其它传递依赖（曾为 mysql-connector 的 3.11.x）就近优先压低版本导致启动失败 -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>3.25.5</version>
            </dependency>

            <!-- 直接使用 fastjson2，保持现有核心版本，避免 JSON/hash 兼容性漂移 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>2.0.28</version>
            </dependency>
            <!-- 架构守护（test scope）：分层边界用可执行规则锁定，见 ArchBoundaryTest -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>1.3.0</version>
                <scope>test</scope>
            </dependency>

            <!-- 工程模块 -->
            <dependency>
                <groupId>cn.novel.yonren</groupId>
                <artifactId>novel_factory-api</artifactId>
                <version>1.3.0</version>
            </dependency>
            <dependency>
                <groupId>cn.novel.yonren</groupId>
                <artifactId>novel_factory-domain</artifactId>
                <version>1.3.0</version>
            </dependency>
            <dependency>
                <groupId>cn.novel.yonren</groupId>
                <artifactId>novel_factory-infrastructure</artifactId>
                <version>1.3.0</version>
            </dependency>
            <dependency>
                <groupId>cn.novel.yonren</groupId>
                <artifactId>novel_factory-types</artifactId>
                <version>1.3.0</version>
            </dependency>
            <dependency>
                <groupId>cn.novel.yonren</groupId>
                <artifactId>novel_factory-trigger</artifactId>
                <version>1.3.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
